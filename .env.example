# Opcional: CMS com Supabase (ver CMS_SETUP.md)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# VITE_PUBLIC_SITE_URL=https://www.convitesdiversos.com.br

# Opcional: Google Analytics 4
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional: Google Ads (gtag — pode combinar com GA4 acima)
# Tag da conta (remarketing / base). Ex.: AW-1234567890
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Conversão «orçamento / contacto» — copiar do Google Ads → Ferramentas → Conversões → Etiqueta
# (formato AW-1234567890/LabelGeradoPeloGoogle)
# VITE_GOOGLE_ADS_CONVERSION_ORCAMENTO_SEND_TO=AW-XXXXXXXXXX/xxxxxxxxxx
# Evento de conversão no formato novo do Google Ads (padrão: conversion_event_contact)
# VITE_GOOGLE_ADS_CONVERSION_CONTACT_EVENT_NAME=conversion_event_contact
