# Convite SPA (Vite) + Apache. Em subpasta, ajuste RewriteBase (ex.: /clientes/convite/).
<IfModule mod_headers.c>
# HTML/PHP/JS/CSS carregam sempre a versão atual; evita celular preso em bundle antigo.
<FilesMatch "\.(html|php|js|css|json|map)$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>

# Media pesada pode ficar em cache para preservar a velocidade dos convites.
<FilesMatch "\.(png|jpg|jpeg|webp|gif|svg|ico|mp3|wav|ogg|webm|mp4)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Atalhos de ficheiros
RewriteRule ^favicon\.ico$ /favicon.svg [L]

# Link de compartilhamento (WhatsApp/Instagram/etc): /i/slug
# Entrega metatags OG/Twitter no servidor e redireciona para /c/slug.
# A capa sai em JPEG no próprio domínio, com o nome do arquivo na URL para o WhatsApp atualizar quando a foto muda.
RewriteRule ^i/([a-z0-9-]{2,64})/capa/([a-z0-9]{8,64})\.jpg$ /preview.php?slug=$1&img=$2 [L,QSA,NC]
RewriteRule ^i/([a-z0-9-]{2,64})/?$ /preview.php?slug=$1 [L,QSA,NC]

# Evita confusão ao abrir artefatos SEO sob /c/*
RewriteRule ^c/(sitemap\.xml|robots\.txt)$ /$1 [R=301,L,NC]

# Mantém ficheiros e pastas reais
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback
RewriteRule ^ /index.html [L]
</IfModule>
